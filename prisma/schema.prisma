// Prisma schema for the AI Airline Booking Bot
// Target DB: Supabase Postgres (works with any Postgres too)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  CHECKED_IN
  COMPLETED
}

enum FlightStatus {
  ACTIVE
  CANCELLED
  DELAYED
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

enum CheckinStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  phone         String?
  passwordHash  String        @map("password_hash")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  bookings      Booking[]
  chatSessions  ChatSession[]

  @@map("users")
}

model Airport {
  id        String   @id @default(uuid())
  code      String   @unique // e.g. DEL
  name      String
  city      String
  country   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  flightsFrom Flight[] @relation("OriginAirport")
  flightsTo   Flight[] @relation("DestinationAirport")

  @@map("airports")
}

model Flight {
  id               String       @id @default(uuid())
  flightNumber     String       @map("flight_number")
  airline          String
  originCode       String       @map("origin")
  destinationCode  String       @map("destination")
  origin           Airport      @relation("OriginAirport", fields: [originCode], references: [code])
  destination      Airport      @relation("DestinationAirport", fields: [destinationCode], references: [code])
  departureTime    DateTime     @map("departure_time")
  arrivalTime      DateTime     @map("arrival_time")
  durationMinutes  Int          @map("duration_minutes")
  basePrice        Decimal      @map("base_price") @db.Decimal(10, 2)
  currency         String       @default("INR")
  cabinClass       CabinClass   @default(ECONOMY) @map("cabin_class")
  totalSeats       Int          @map("total_seats")
  availableSeats   Int          @map("available_seats")
  status           FlightStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  bookings Booking[]

  @@index([originCode, destinationCode, departureTime])
  @@map("flights")
}

model Booking {
  id           String        @id @default(uuid())
  bookingId    String        @unique @map("booking_id")
  pnr          String        @unique
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id])
  flightId     String        @map("flight_id")
  flight       Flight        @relation(fields: [flightId], references: [id])
  status       BookingStatus @default(CONFIRMED)
  totalAmount  Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency     String        @default("INR")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  passengers Passenger[]
  checkin    Checkin?

  @@index([userId])
  @@map("bookings")
}

model Passenger {
  id            String   @id @default(uuid())
  bookingId     String   @map("booking_id")
  booking       Booking  @relation(fields: [bookingId], references: [id])
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  email         String
  phone         String
  dateOfBirth   DateTime @map("date_of_birth")

  @@map("passengers")
}

model Checkin {
  id              String        @id @default(uuid())
  bookingId       String        @unique @map("booking_id")
  booking         Booking       @relation(fields: [bookingId], references: [id])
  seatNumber      String        @map("seat_number")
  boardingPassId  String        @unique @map("boarding_pass_id")
  checkinTime     DateTime      @default(now()) @map("checkin_time")
  status          CheckinStatus @default(COMPLETED)

  @@map("checkins")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  sessionId String   @unique @map("session_id")
  state     Json?    // holds in-progress slot-filling context
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id])
  role      ChatRole
  message   String
  intent    String?
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("chat_messages")
}

PORT=3000
NODE_ENV=development

# Supabase Postgres connection strings.
# DATABASE_URL: pooled connection (port 6543) — used at runtime by the app.
# DIRECT_URL: direct connection (port 5432) — used only by Prisma Migrate.
# Get both from Supabase Dashboard -> Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Long random string used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional: enables higher-quality LLM-based intent/entity extraction.
# If left blank, the chatbot falls back to a rule-based NLU parser that
# already handles all example scenarios in the spec.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web check-in window (hours before departure), configurable per spec section 9.
CHECKIN_OPENS_HOURS_BEFORE=48
CHECKIN_CLOSES_HOURS_BEFORE=2
